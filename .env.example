# ── DVC remote storage ────────────────────────────────────────────────────────
# Local filesystem path on the ECS NFS home (see .dvc/config) — no credentials
# needed. Replaces DigitalOcean Spaces (student credit expires 31 July).

# ── DigitalOcean Managed PostgreSQL (MLflow + prediction log) ─────────────────
DATABASE_URL=postgresql://user:password@host:5432/wildlife_pipeline

# ── MLflow tracking server ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Sentry (inference API error tracking) ─────────────────────────────────────
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ── Azure (backup GPU training) ───────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=your_subscription_id

# ── Doppler manages secrets in production — this file is local dev only ───────
